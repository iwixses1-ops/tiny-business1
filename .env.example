# Скопируй этот файл в .env и заполни значения.
# На Bothost переменные можно задать в форме создания бота («Переменные
# окружения»), и тогда .env в репозиторий кладти НЕ нужно.

# --- Обязательно ---
# Токен бота от @BotFather.
BOT_TOKEN=

# --- Адрес Mini App (HTTPS!) ---
# Bothost выдаёт домен вида https://bot1234.bothost.tech — вставь его сюда.
# Именно этот адрес откроется по кнопке «Играть».
WEBAPP_URL=https://bot1234.bothost.tech

# --- Публичный режим ---
# true — принудительно требует корректную подпись Telegram,
#         слушает 0.0.0.0. ОБЯЗАТЕЛЬНО для Mini App в проде.
PUBLIC_DEPLOYMENT=true

# Локальный тест (доступ без Telegram). В проде держи false.
ALLOW_LOCAL_TEST=false

# Максимальный возраст initData (сек). 600 = 10 минут.
AUTH_MAX_AGE_SECONDS=600

# --- Сеть ---
# Bothost обычно передаёт порт через переменную PORT (мы её читаем сами).
# Явно задавать не обязательно; можно оставить так:
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# --- CORS ---
# Frontend и API на одном домене, поэтому "*" безопасно.
CORS_ORIGINS=*

# --- База данных ---
DATABASE_PATH=data/tiny_business.db

# --- Администраторы ---
# Telegram ID админов через запятую. Только они видят админ-панель в Mini App
# и команду /admin. Свой ID можно узнать у бота @userinfobot.
# Пример: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# --- Владелец (приём оплаты за донат-услуги) ---
# Юзернейм владельца (без @) — ссылка t.me/<username> на заявках.
# Либо ID владельца: OWNER_ID=<tg id>
OWNER_USERNAME=
OWNER_ID=

# --- Рассылка ---
# Задержка между сообщениями (сек) — больше = безопаснее для Telegram.
BROADCAST_DELAY_SEC=1
# Максимум сообщений в минуту (запасной лимит скорости).
BROADCAST_RATE_PER_MIN=20

# --- Бот ---
BOT_AUTO_START=true